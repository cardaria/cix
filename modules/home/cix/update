#!/usr/bin/env bash
set -euo pipefail

action=${CIX_ACTION:-update}
[[ $action == update || $action == rollback ]] || exit 1

usage() {
  if [[ $action == rollback ]]; then
    cat << EOF2
Usage: cix rollback <target> [<guest> ...] [options]

Targets: ${HOSTNAME:-<this host>}, pve, or one or more guest names.
This machine: prepare an older system generation for the next boot.
Guests: review older generations, then activate and check them stage by stage.

Options:
      --list          list retained generations; change nothing
      --generation N  select a generation explicitly (one target only)
  -n, --dry-run       review only; activate nothing
  -v, --verbose       show every command's full output
  -h, --help          show this help

Without --generation, choose the earlier distinct generation of each profile.
No inputs, image pins, Git files or application data are reverted.
EOF2
    return
  fi
  echo "Usage: cix update <target> [<guest> ...] [options]"
  echo
  echo "Targets:"
  printf '  %-12s %s\n' \
    "${HOSTNAME:-<this host>}" "this machine: update its inputs, check and build a fixed source" \
    "" "snapshot, review the changes, then ask to install it for the next" \
    "" "boot. Reboot yourself when ready." \
    pve "every guest on the Proxmox host pve, stage by stage;" \
    "" "then what the host itself has pending" \
    "<guest> ..." "selected guests on pve, in registry stage order"
  cat << EOF2
Without a target, cix update lists the guests and changes nothing.

Options for this machine:
  -c, --cuda     also bump the CUDA pin (recompiles the CUDA packages)
  -n, --dry-run  update, check and build only; no privileged commands
      --no-update  use the existing lock file, including for a retry
  -v, --verbose  show every command's full output
  -h, --help     show this help

Options for pve and its guests:
  -n, --dry-run  update, check, build and review only; deploy nothing
      --no-update  deploy the current lock file and image pins, for a retry
      --no-images  leave the container image pins as they are
  -v, --verbose  show every command's full output
EOF2
}

requested=()
opts=()
while (($#)); do
  arg=$1
  shift
  case $arg in
  -h | --help)
    usage
    exit 0
    ;;
  --generation)
    [[ $action == rollback && ${1:-} =~ ^[1-9][0-9]*$ ]] || {
      usage >&2
      exit 1
    }
    opts+=("$arg" "$1")
    shift
    ;;
  -*) opts+=("$arg") ;;
  *)
    for existing in "${requested[@]}"; do
      [[ $arg != "$existing" ]] || continue 2
    done
    requested+=("$arg")
    ;;
  esac
done

# The guests are the pve repo's systems that are machines in their own registry
guests() {
  # shellcheck disable=SC2016
  nix eval --json --option warn-dirty false "$PVE#nixosConfigurations" --apply \
    'cs: builtins.filter (n: ((cs.${n}.config.pve or { }).machines or { }) ? ${n}) (builtins.attrNames cs)' |
    jq -r '.[]'
}

host=$(hostname)
if ((${#requested[@]} == 0)); then
  usage
  printf '\nGuests on pve: %s\n' "$(guests | paste -sd ' ')"
  exit 0
fi
target=${requested[0]}
if ((${#requested[@]} > 1)) && [[ " ${requested[*]} " == *" $host "* || " ${requested[*]} " == *" pve "* ]]; then
  echo "Use this machine or pve alone; only guest names can be combined." >&2
  exit 1
fi
if [[ $target != "$host" ]]; then
  known=$(guests)
  for target in "${requested[@]}"; do
    if [[ $target != pve ]] && ! grep -qxF -- "$target" <<< "$known"; then
      echo "cix $action: unknown target '$target'. Run cix $action to list the targets." >&2
      exit 1
    fi
  done
  export CIX_ACTION=$action
  exec cix-update-pve "${requested[@]}" "${opts[@]}"
fi

inputs=(nixpkgs home-manager plasma-manager chandra-src chandra-model pve)
dry=false
update=true
cuda=false
list=false
generation=
set -- "${opts[@]}"
while (($#)); do
  arg=$1
  shift
  if [[ $action == rollback ]]; then
    case $arg in
    --list) list=true ;;
    --generation)
      generation=$1
      shift
      ;;
    -n | --dry-run) dry=true ;;
    -v | --verbose) ui_verbose=true ;;
    *)
      usage >&2
      exit 1
      ;;
    esac
    continue
  fi
  case $arg in
  -c | --cuda) cuda=true ;;
  -n | --dry-run) dry=true ;;
  --no-update) update=false ;;
  -v | --verbose) ui_verbose=true ;;
  *)
    usage >&2
    exit 1
    ;;
  esac
done
if $cuda && ! $update; then
  echo "--cuda and --no-update cannot be combined" >&2
  exit 1
fi
$cuda && inputs+=(nixpkgs-cuda)

cd "$REPO"
umask 077
# Keep the lock inode in place so waiting processes cannot bypass it
exec 9> "$(git rev-parse --git-common-dir)/cix-update.lock"
flock -n 9 || {
  echo "Another cix update or rollback is running" >&2
  exit 1
}

if [[ $action == update ]]; then
  untracked=$(git ls-files --others --exclude-standard)
  if [[ -n $untracked ]]; then
    printf 'Git flakes exclude untracked files. Review and stage intended files first:\n%s\n' "$untracked" >&2
    exit 1
  fi
  changes=$(git status --short)
  if [[ -n $changes ]]; then
    section "Uncommitted changes"
    while IFS= read -r line; do printf '  %s\n' "$line"; done <<< "$changes"
    ask "Build with these changes?" || exit 1
  fi
fi

state=${XDG_STATE_HOME:-$HOME/.local/state}/cix/updates
mkdir -p "$state"
run=$(mktemp -d "$state/run.XXXXXXXX")
phase=prepare
out=
previous=$(readlink -e /nix/var/nix/profiles/system)
current=$(readlink -e /run/current-system)

finish() {
  local status=$?
  ui_cleanup
  if ((status)); then
    printf '\n  Stopped during %s (status %s)\n' "$phase" "$status" >&2
    if [[ $phase == boot ]]; then
      note "The boot menu may be partially updated. Before rebooting, retry this exact build:" >&2
      printf '    sudo nixos-rebuild boot --store-path %q --no-reexec\n' "$out" >&2
      note "or restore the previous boot configuration:" >&2
      printf '    sudo nixos-rebuild boot --store-path %q --no-reexec\n' "$previous" >&2
    elif [[ $action == update && $phase != prepare && $phase != backups ]]; then
      note "The lock file may have changed; retry with cix update $host --no-update" >&2
    fi
    note "Log  ${run/#$HOME/\~}" >&2
  fi
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

lock_rev() {
  jq -r --arg i "$1" '.nodes[$i].locked.rev // empty | .[0:7]' flake.lock
}

# Package changes as name, versions and size in bytes, largest first
changes_by_size() {
  awk '
    {
      i = index($0, ": "); name = substr($0, 1, i - 1); rest = substr($0, i + 2); ver = ""; size = ""
      if (match(rest, /, [+-][0-9.]+ [KMGT]?i?B$/)) { size = substr(rest, RSTART + 2); ver = substr(rest, 1, RSTART - 1) }
      else if (rest !~ /^[+-][0-9.]+ [KMGT]?i?B$/) ver = rest
      if (ver == "") next
      split(size, s, " "); n = s[1] + 0; if (n < 0) n = -n
      n *= s[2] ~ /^Ki/ ? 1024 : s[2] ~ /^Mi/ ? 1048576 : s[2] ~ /^Gi/ ? 1073741824 : 1
      printf "%d\t%s\t%s\n", n, name, ver
    }' "$run/changes.txt" | LC_ALL=C sort -t $'\t' -k1,1nr
}

all_changes() {
  section "All changes ()"
  changes_by_size | LC_ALL=C sort -t $'\t' -k2,2 | while IFS=$'\t' read -r _ name ver; do item "$name" "$ver"; done
  echo
}

section "cix $action $host"

if [[ $action == rollback ]]; then
  phase=generations
  task "Generations" "$run/generations.log" bash -c "$generation_scan"
  cp "$run/generations.log" "$run/generations"
  if $list; then
    show_generations "$run/generations"
    exit 0
  fi
  IFS=$'\t' read -r generation out < <(select_generation "$run/generations" "$generation")
  [[ $out == /nix/store/* && -x $out/bin/switch-to-configuration ]]
  nix-store --add-root "$run/result" --indirect --realise "$out" > /dev/null
  mark_ok "Rollback" "generation $generation · $out"
else

  phase=backups
  task "Recovery keys" "$run/backups.log" cix-backup --auto --check || {
    note "Run cix backup to resolve it, then retry." >&2
    exit 1
  }
  mark_ok "Recovery keys" "verified in 1Password"

  if $update; then
    phase=inputs
    declare -A before
    for i in "${inputs[@]}"; do before[$i]=$(lock_rev "$i"); done
    task "Inputs" "$run/inputs.log" nix flake update "${inputs[@]}"
    moved=()
    for i in "${inputs[@]}"; do
      now=$(lock_rev "$i")
      [[ $now == "${before[$i]}" ]] || moved+=("$i ${before[$i]} → $now")
    done
    if ((${#moved[@]})); then
      mark_ok "Inputs" "${moved[0]}"
      for m in "${moved[@]:1}"; do detail "$m"; done
    else
      mark_ok "Inputs" "unchanged"
    fi
  else
    mark_ok "Inputs" "kept (--no-update)"
  fi

  # Validation and the build both use the same immutable Git-flake snapshot
  phase=checks
  check_all() {
    local snapshot
    nix flake metadata --json --no-update-lock-file . > "$run/source.json" || return 1
    snapshot=$(jq -er '.path' "$run/source.json") || return 1
    nix flake check "$snapshot" --no-update-lock-file
  }
  task "Checks" "$run/checks.log" check_all
  source=$(jq -er '.path' "$run/source.json")
  [[ $source == /nix/store/* && -f $source/flake.nix ]]
  mark_ok "Checks" "passed"

  phase=build
  # The output link protects the candidate from concurrent garbage collection
  task "Build" "$run/build.log" nix build "$source#nixosConfigurations.$host.config.system.build.toplevel" \
    --out-link "$run/result" --print-out-paths --no-update-lock-file
  out=$(readlink -e "$run/result")
  [[ $out == /nix/store/* && -x $out/bin/switch-to-configuration ]]
  mark_ok "Build" "${out#*-nixos-system-}"

  phase=smoke-check
  if [[ -x $out/sw/bin/nvidia-smi ]]; then
    task "NVIDIA" "$run/nvidia-smi.log" "$out/sw/bin/nvidia-smi" --help || {
      note "nvidia-smi crashes in the new build; nothing was installed." >&2
      exit 1
    }
    mark_ok "NVIDIA" "nvidia-smi starts"
  fi
fi

printf '%s\n' "$out" > "$run/candidate"
printf '%s\n' "$previous" > "$run/previous"
phase=changes
diff_changes() {
  nix store diff-closures "$previous" "$out" > "$run/changes.txt"
}
task "Changes" "$run/changes.log" diff_changes
if [[ $current == *display-5090* && ! -x $out/specialisation/display-5090/bin/switch-to-configuration ]]; then
  mark_fail "Boot entries" "the new build is missing your display-5090 entry"
  exit 1
fi
total=$(changes_by_size | wc -l)
section "Changes at next boot"
if ((total == 0)); then
  note "Same package versions; configuration only"
else
  changes_by_size | awk 'NR <= 8' | while IFS=$'\t' read -r _ name ver; do item "$name" "$ver"; done
  ((total <= 8)) || note "… $((total - 8)) more · c at the question lists them all"
fi
if $dry; then
  echo
  note "Dry run: nothing installed. Log  ${run/#$HOME/\~}"
  exit 0
fi

section "Install"
more=
((total > 8)) && more="c all changes"
ask "Install for the next boot?" "$more" all_changes || {
  note "Nothing installed."
  exit 0
}

# Another deployment tool may have changed the system while this build ran
if [[ $(readlink -e /nix/var/nix/profiles/system) != "$previous" ||
$(readlink -e /run/current-system) != "$current" ]]; then
  echo "The running system or boot profile changed during this update. Review again with --no-update." >&2
  exit 1
fi
phase=boot
# The password prompt needs the terminal; the step itself then runs quietly
ui_show
sudo -v
ui_hide
task "Boot entry" "$run/boot.log" sudo nixos-rebuild boot --store-path "$out" --no-reexec
[[ $(readlink -e /nix/var/nix/profiles/system) == "$out" ]] || {
  mark_fail "Boot entry" "the system profile does not point to the candidate"
  exit 1
}
# The registered system generation now protects this closure from collection
rm -- "$run/result" || note "Could not remove the temporary GC root: $run/result" >&2
phase=complete
generation=$(readlink /nix/var/nix/profiles/system)
[[ $generation =~ ^system-([0-9]+)-link$ ]] && generation=" · generation ${BASH_REMATCH[1]}" || generation=
mark_ok "Boot entry" "installed for the next boot$generation"
note "Reboot when ready; the previous generation stays in the boot menu."
