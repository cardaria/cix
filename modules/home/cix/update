#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF
Usage: cix update [--cuda] [--dry-run]

Updates the flake inputs, builds, previews the changes, then asks before
applying. Picks the right activation for the booted entry, display-5090 included.

  -c, --cuda     also bump the CUDA pin (recompiles the CUDA packages)
  -n, --dry-run  stop after the preview
  -h, --help     show this help
EOF
}

inputs=(nixpkgs home-manager plasma-manager chandra-src chandra-model)
dry=false
for arg in "$@"; do
  case $arg in
    -c | --cuda) inputs+=(nixpkgs-cuda) ;;
    -n | --dry-run) dry=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

step() {
  if [[ -t 1 ]]; then
    printf '\n\033[1m%s\033[0m\n' "$*"
  else
    printf '\n%s\n' "$*"
  fi
}

# Runs a command silently and shows its output only when it fails
quiet() {
  local log status=0
  log=$(mktemp)
  "$@" > "$log" 2>&1 || status=$?
  if ((status)); then
    cat "$log" >&2
  fi
  rm -f "$log"
  return "$status"
}

confirm() {
  local reply
  read -r -n1 -p "$1 [y/N] " reply
  echo
  [[ $reply == [yY] ]]
}

cd "$REPO"

step "Inputs"
before=$(cksum < flake.lock)
quiet nix flake update "${inputs[@]}"
if [[ $(cksum < flake.lock) == "$before" ]]; then
  echo "Already up to date"
else
  git diff --stat -- flake.lock
fi

step "Build"
out=$(nix build ".#nixosConfigurations.$(hostname).config.system.build.toplevel" \
  --no-link --print-out-paths --no-write-lock-file --option warn-dirty false)
current=$(readlink -f /run/current-system)

if [[ $current == *display-5090* ]]; then
  # The base closure would swap the display GPU under the running session
  target=$(readlink -f "$out/specialisation/display-5090")
  activate() { sudo "$target/bin/switch-to-configuration" "$1"; }
  persist() {
    sudo nix-env -p /nix/var/nix/profiles/system --set "$out"
    sudo "$out/bin/switch-to-configuration" boot
  }
else
  target=$out
  activate() { sudo nixos-rebuild "$1" --store-path "$out" --no-reexec; }
  persist() { sudo nixos-rebuild switch --store-path "$out" --no-reexec; }
fi

live=false
kept=false
[[ $current == "$target" ]] && live=true
[[ $(readlink -f /nix/var/nix/profiles/system) == "$out" ]] && kept=true
if $live && $kept; then
  step "Already applied"
  echo "Running and boot default: ${out##*-}"
  exit 0
fi

step "Changes"
changes=$(nix store diff-closures "$current" "$target" | grep -E ' → ' | grep -vE '^nixos-system|∅ → ε' || true)
echo "${changes:-No package changes}"

step "Service restarts"
if ! raw=$(activate dry-activate 2>&1); then
  echo "$raw" >&2
  exit 1
fi
restarts=$(grep -vE '^(Not checking switch inhibitors|would activate the configuration)' <<< "$raw" || true)
echo "${restarts:-None}"

if $dry; then
  exit 0
fi

if ! $live; then
  echo
  confirm "Apply now?" || {
    echo "Nothing applied; flake.lock stays updated"
    exit 0
  }
  quiet activate test
  failed=$(systemctl --failed --no-legend)
  if [[ -n $failed ]]; then
    echo "Failed units:"
    echo "$failed"
  else
    echo "Applied, no failed units"
  fi
fi

if $live; then
  echo
fi
confirm "Keep after reboot?" || {
  echo "Live only; a reboot returns to the old build"
  exit 0
}
quiet persist
profile=$(readlink -f /nix/var/nix/profiles/system)
echo "Boot default: ${profile##*-}"
