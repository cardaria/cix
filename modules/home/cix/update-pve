#!/usr/bin/env bash
# Updates and rollbacks share the registry's planner, review and sequential deployment
set -euo pipefail

action=${CIX_ACTION:-update}
[[ $action == update || $action == rollback ]] || exit 1
requested=()
inputs=(nixpkgs-stable nixpkgs-pve)
dry=false
update=true
images=true
list=false
generation=
while (($#)); do
  arg=$1
  shift
  if [[ $action == rollback && $arg == --generation ]]; then
    [[ ${1:-} =~ ^[1-9][0-9]*$ ]] || {
      echo "--generation needs a positive number" >&2
      exit 1
    }
    generation=$1
    shift
    continue
  fi
  case $arg in
  -n | --dry-run) dry=true ;;
  --no-update)
    [[ $action == update ]] || exit 1
    update=false
    ;;
  --no-images)
    [[ $action == update ]] || exit 1
    images=false
    ;;
  --list)
    [[ $action == rollback ]] || exit 1
    list=true
    ;;
  -v | --verbose) ui_verbose=true ;;
  -*)
    echo "cix $action: unknown option '$arg'. Run cix $action --help." >&2
    exit 1
    ;;
  *)
    for existing in "${requested[@]}"; do
      [[ $arg != "$existing" ]] || continue 2
    done
    requested+=("$arg")
    ;;
  esac
done
target=${requested[*]}
if ((${#requested[@]} == 0)) || { ((${#requested[@]} > 1)) && [[ " $target " == *" pve "* ]]; }; then
  echo "Name pve alone, or one or more guests." >&2
  exit 1
fi
if [[ -n $generation ]] && { ((${#requested[@]} != 1)) || [[ $target == pve ]]; }; then
  echo "--generation requires one named guest." >&2
  exit 1
fi

cd "$REPO"
umask 077
# One update of the pve repo at a time
exec 9> "$(git rev-parse --git-common-dir)/cix-update.lock"
flock -n 9 || {
  echo "Another cix update or rollback is running" >&2
  exit 1
}

if [[ $action == update ]]; then
  untracked=$(git ls-files --others --exclude-standard)
  if [[ -n $untracked ]]; then
    printf 'Git flakes exclude untracked files. Review and stage intended files first:\n%s\n' "$untracked" >&2
    exit 1
  fi
  changes=$(git status --short)
  if [[ -n $changes ]]; then
    section "Uncommitted changes in the pve repo"
    while IFS= read -r line; do printf '  %s\n' "$line"; done <<< "$changes"
    ask "Build with these changes?" || exit 1
  fi
fi

state=${XDG_STATE_HOME:-$HOME/.local/state}/cix/updates
mkdir -p "$state"
run=$(mktemp -d "$state/pve.XXXXXXXX")
phase=plan
guest=
address=
previous=

finish() {
  local status=$?
  ui_cleanup
  if ((status)); then
    printf '\n  Stopped during %s (status %s)\n' "$phase" "$status" >&2
    if [[ $phase == deploy && -n $previous ]]; then
      note "$guest may run the new build. Return it to the one it ran before with:" >&2
      printf '    nixos-rebuild switch --store-path %q --target-host root@%s --no-reexec\n' "$previous" "$address" >&2
    fi
    if [[ $action == update && $phase != plan && $phase != preflight ]]; then
      note "flake.lock and the image pins may have changed; review with git diff, retry with --no-update" >&2
    fi
    note "Log  ${run/#$HOME/\~}" >&2
  fi
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# A guest's shell, as root with this machine's key
remote() {
  local address=$1
  shift
  ssh -n -o BatchMode=yes -o ConnectTimeout=10 "root@$address" "$@"
}

# --- Plan: everything comes from the registry, so a new guest is one entry there ---

# shellcheck disable=SC2016
plan='cs:
  let
    names = builtins.filter (n: ((cs.${n}.config.pve or { }).machines or { }) ? ${n}) (builtins.attrNames cs);
    pve = cs.${builtins.head names}.config.pve;
  in
  {
    host = pve.machines.pve.address or null;
    checks = builtins.attrValues (builtins.mapAttrs (name: c: { inherit name; inherit (c) host kind target query expect; }) pve.checks);
    guests = map (n:
      let
        c = cs.${n}.config;
        m = c.pve.machines.${n};
      in
      {
        name = n;
        inherit (m) address;
        inherit (m.update) stage settle autoRollback containers;
        images = builtins.attrValues (builtins.mapAttrs (container: x: { inherit container; inherit (x) image; }) c.virtualisation.oci-containers.containers);
      }) names;
  }'

load_plan() {
  local g
  nix eval --json --option warn-dirty false "$1#nixosConfigurations" --apply "$plan" > "$run/registry.json"
  for g in "${requested[@]}"; do
    [[ $g == pve ]] || jq -e --arg g "$g" '.guests | any(.name == $g)' "$run/registry.json" > /dev/null || {
      echo "Unknown guest: $g" >&2
      return 1
    }
  done
  jq -n --slurpfile registry "$run/registry.json" --args \
    '$registry[0] | .guests |= (map(select(.name as $n | ($ARGS.positional | index("pve") != null or index($n) != null))) | sort_by(.stage, .name))' \
    "${requested[@]}" > "$run/plan.json"
  jq -e '.guests | length > 0' "$run/plan.json" > /dev/null
}

guests() {
  jq -r '.guests[].name' "$run/plan.json"
}

# One field of a guest
field() {
  jq -r --arg g "$1" ".guests[] | select(.name == \$g) | .$2" "$run/plan.json"
}

candidate() {
  if [[ $action == rollback ]]; then
    cat "$run/$1.destination"
  else
    readlink -e "$run/$1"
  fi
}

# --- Health: the registry's checks, the same the status page runs, plus no failed units ---

probe() {
  local kind=$1 target=$2 query=$3 expect=$4 code
  case $kind in
  proxy | http)
    code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "$target" 2> /dev/null || true)
    [[ $code =~ ^[0-9]+$ ]] || return 1
    if [[ $kind == proxy ]]; then
      ((10#$code > 0 && 10#$code < 500))
    else
      [[ $code == "$expect" ]]
    fi
    ;;
  dns) [[ $(dig +short +time=3 +tries=2 "@$target" "$query" A 2> /dev/null) == "$expect" ]] ;;
  tcp)
    # shellcheck disable=SC2016
    timeout 5 "$BASH" -c 'exec 3<> "/dev/tcp/$1/$2"' _ "${target%:*}" "${target##*:}" 2> /dev/null
    ;;
  *) return 1 ;;
  esac
}

# Prints the checks that fail, all run at once
failing_checks() {
  local dir name kind target query expect f
  dir=$(mktemp -d "$run/checks.XXXXXXXX")
  while IFS=$'\x1f' read -r name kind target query expect; do
    { probe "$kind" "$target" "$query" "$expect" < /dev/null || : > "$dir/$name"; } &
  done < <(jq -r '.checks[] | [.name, .kind, .target, .query // "", .expect // ""] | join("\u001f")' "$run/plan.json")
  wait
  for f in "$dir"/*; do
    [[ -e $f ]] && printf '%s\n' "${f##*/}"
  done
  rm -r -- "$dir"
}

failed_units() {
  remote "$1" systemctl list-units --state=failed --plain --no-legend --no-pager
}

# Waits up to seconds for every check to pass and the guest, if named, to have no failed units
healthy() {
  local seconds=$1 address=${2:-} failing units tries i
  tries=$(((seconds + 9) / 10))
  for ((i = 1; ; i++)); do
    failing=$(failing_checks)
    # Checks that already failed before the update, and the user accepted, are not this deploy's fault
    if [[ -s $run/baseline ]]; then
      failing=$(grep -vxFf "$run/baseline" <<< "$failing" || true)
    fi
    units=
    if [[ -n $address ]]; then
      units=$(failed_units "$address") || units="(no answer over SSH)"
    fi
    [[ -z $failing && -z $units ]] && return 0
    ((i < tries)) || break
    sleep 10
  done
  [[ -z $failing ]] || printf 'Failing checks: %s\n' "$(paste -sd ' ' <<< "$failing")" >&2
  [[ -z $units ]] || printf 'Failed units on %s:\n%s\n' "$address" "$units" >&2
  return 1
}

# --- Changes ---

# Package versions that differ between two closures, as nix store diff-closures names them
# shellcheck disable=SC2016
versions='
  function parse(path,   b) {
    b = path; sub(/^.*\//, "", b); sub(/^[0-9a-z]{32}-/, "", b)
    if (match(b, /-[0-9]/)) { name = substr(b, 1, RSTART - 1); ver = substr(b, RSTART + 1) } else { name = b; ver = "" }
    sub(/-(bin|dev|lib|man|doc|info|debug|static|data|devdoc|terminfo|getent|modules|scripts|py|login|mount|swap)$/, "", ver)
  }
  function add(set, n, v) { if (index(" " set[n] " ", " " v " ") == 0) set[n] = set[n] == "" ? v : set[n] " " v }
  function sorted(s,   a, n, i, r) { n = split(s, a, " "); asort(a); r = ""; for (i = 1; i <= n; i++) r = r (i > 1 ? ", " : "") a[i]; return r }
  function major(v) { sub(/^v/, "", v); return match(v, /^[0-9]+/) ? substr(v, 1, RLENGTH) : "" }
  { parse($0); if (ver == "") next; seen[name]; if (FILENAME == ARGV[1]) add(old, name, ver); else add(new, name, ver) }
  END {
    for (n in seen) {
      o = sorted(old[n]); w = sorted(new[n])
      if (o == w) continue
      flag = (o != "" && w != "" && o !~ /,/ && w !~ /,/ && major(o) != "" && major(w) != "" && major(o) != major(w)) ? "major" : ""
      printf "%s\t%s → %s\t%s\n", n, o == "" ? "∅" : o, w == "" ? "∅" : w, flag
    }
  }'

major() {
  local v=${1#v}
  [[ $v =~ ^[0-9]+ ]] && printf '%s' "${BASH_REMATCH[0]}"
}

label() {
  local v
  v=$(skopeo inspect --retry-times 2 --format '{{index .Labels "org.opencontainers.image.version"}}' "docker://$1" 2> /dev/null || true)
  [[ $v == "<no value>" ]] && v=
  printf '%s' "$v"
}

# Follows a pinned image's tag to its current digest and moves the pin in the repo
bump() {
  local g=$1 container=$2 image=$3 ref name old new file count content from to flag=''
  ref=${image%@*}
  name=${ref%:*}
  old=${image#*@}
  new=$(skopeo inspect --retry-times 2 --raw "docker://$ref" | skopeo manifest-digest /dev/stdin)
  [[ $new =~ ^sha256:[0-9a-f]{64}$ ]] || {
    echo "No digest for $ref" >&2
    return 1
  }
  [[ $new == "$old" ]] && return 0
  count=$(git grep -cF -- "$image" | awk -F: '{ n += $NF } END { print n + 0 }')
  [[ $count == 1 ]] || {
    echo "The pin $image appears $count times in the repo; expected once" >&2
    return 1
  }
  file=$(git grep -lF -- "$image")
  content=$(< "$file")
  printf '%s\n' "${content//"$image"/"$ref@$new"}" > "$file"
  from=$(label "$name@$old")
  to=$(label "$name@$new")
  if [[ -n $(major "$from") && -n $(major "$to") && $(major "$from") != "$(major "$to")" ]]; then
    flag=major
  fi
  # A label like latest or main says nothing, so the digests tell the two apart
  if [[ -z $from || -z $to || $from == "$to" ]]; then
    from="${from:+$from }${old:7:12}"
    to="${to:+$to }${new:7:12}"
  fi
  printf '%s\t%s\t%s → %s\t%s\n' "$g" "$container" "$from" "$to" "$flag" >> "$run/images.tsv"
}

lock_rev() {
  jq -r --arg i "$1" '.nodes[$i].locked.rev // empty | .[0:7]' flake.lock
}

host_report() {
  local address
  address=$(jq -r '.host // empty' "$run/plan.json")
  [[ -n $address ]] || return 0
  # shellcheck disable=SC2016
  remote "$address" '
    n=$(apt-get -s -q dist-upgrade 2> /dev/null | grep -c "^Inst ")
    printf "apt\t%s update%s · apt full-upgrade\n" "$n" "$([ "$n" = 1 ] || echo s)"
    r=$(uname -r)
    k=$(ls /boot/vmlinuz-* | sed "s|^/boot/vmlinuz-||" | sort -V | tail -n 1)
    if [ "$r" = "$k" ]; then printf "kernel\t%s, the newest installed\n" "$r"; else printf "kernel\treboot pending: running %s, newest %s\n" "$r" "$k"; fi
  ' > "$run/host.tsv" || printf 'host\tno answer over SSH\n' > "$run/host.tsv"
}

# --- Steps, each run by task with a spinner ---

preflight() {
  local g units
  : > "$run/failed-units"
  for g in "${targets[@]}"; do
    units=$(failed_units "$(field "$g" address)") || {
      echo "$g does not answer over SSH"
      return 1
    }
    if [[ -n $units ]]; then
      printf 'Failed units on %s:\n%s\n' "$g" "$units"
      [[ $action == rollback ]] || {
        echo "Fix them first."
        return 1
      }
      printf '%s\n' "$g" >> "$run/failed-units"
    fi
  done
  # A failing check is reported, not decided here: a service this very update adds fails until it is deployed
  : > "$run/baseline"
  failing_checks > "$run/baseline"
}

prepare_rollbacks() {
  local g address number path
  for g in "${targets[@]}"; do
    address=$(field "$g" address)
    remote "$address" "$generation_scan" > "$run/$g.generations" || return 1
    if $list; then
      section "$g"
      show_generations "$run/$g.generations"
      continue
    fi
    IFS=$'\t' read -r number path < <(select_generation "$run/$g.generations" "$generation") || return 1
    [[ $path == /nix/store/* ]] || return 1
    printf '%s\n' "$number" > "$run/$g.generation"
    remote "$address" readlink -f /run/current-system > "$run/$g.before" || return 1
    printf '%s\n' "$path" > "$run/$g.destination"
    remote "$address" command -v nixos-rebuild > /dev/null || return 1
  done
}

bump_all() {
  local g container image
  for g in "${targets[@]}"; do
    [[ $(field "$g" containers) == pinned ]] || continue
    while IFS=$'\t' read -r container image; do
      bump "$g" "$container" "$image"
    done < <(jq -r --arg g "$g" '.guests[] | select(.name == $g) | .images[] | [.container, .image] | @tsv' "$run/plan.json")
  done
}

snapshot() {
  nix flake metadata --json --option warn-dirty false --no-update-lock-file . > "$run/source.json"
}

build_all() {
  local g
  for g in "${targets[@]}"; do
    # The output link keeps the build from garbage collection until it is deployed
    nix build "$source#nixosConfigurations.$g.config.system.build.toplevel" \
      --out-link "$run/$g" --print-out-paths --no-update-lock-file
    [[ -x $(readlink -e "$run/$g")/bin/switch-to-configuration ]]
  done
}

# What each guest runs now against its new build: up to date, or its image and package changes
compare_all() {
  local g address new current
  for g in "${targets[@]}"; do
    address=$(field "$g" address)
    new=$(candidate "$g")
    current=$(remote "$address" readlink -f /run/current-system) || return 1
    if [[ $action == rollback && $current != "$(< "$run/$g.before")" ]]; then
      echo "$g changed while preparing the rollback; review again." >&2
      return 1
    fi
    printf '%s\n' "$current" > "$run/$g.previous"
    awk -F '\t' -v g="$g" '$1 == g { print $2 "\t" $3 "\t" $4 }' "$run/images.tsv" > "$run/$g.images"
    : > "$run/$g.changes"
    if [[ $new == "$current" ]]; then
      echo same > "$run/$g.state"
      continue
    fi
    echo changed > "$run/$g.state"
    remote "$address" nix-store -qR "$current" > "$run/$g.old" || return 1
    if [[ $action == rollback ]]; then
      remote "$address" nix-store -qR "$new" > "$run/$g.new" || return 1
    else
      nix-store -qR "$new" > "$run/$g.new" || return 1
    fi
    gawk "$versions" "$run/$g.old" "$run/$g.new" | LC_ALL=C sort > "$run/$g.changes"
  done
  if [[ $action == update && $target == pve ]]; then
    host_report
  fi
}

# One line of live status for the download: paths done, data moved and its speed
human() {
  awk -v b="$1" 'BEGIN { split("B KB MB GB", u); i = 1; while (b >= 1024 && i < 4) { b /= 1024; i++ } printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i] }'
}

copy_progress() {
  local log=$1 sizes=$2 started=$3 prefix=$4 total copied bytes secs
  total=$(awk '/^copying [0-9]+ paths/ { print $2 }' "$log" | tail -n 1)
  copied=$(grep -c "^copying path " "$log" || true)
  bytes=$(awk 'FNR == 1 { second = (FILENAME == ARGV[2]) } !second { size[$1] = $2; next } /^copying path / { split($0, p, "\047"); sum += size[p[2]] } END { print sum + 0 }' "$sizes" "$log")
  secs=$(($(date +%s) - started))
  printf '%s%s/%s paths · %s' "$prefix" "$copied" "${total:-?}" "$(human "$bytes")"
  ((secs > 0 && bytes > 0)) && printf ' · %s/s' "$(human $((bytes / secs)))"
  echo
}

download_all() {
  local g address image n=0 count=${#changed[@]} prefix started log sizes copy_pid refs
  for g in "${changed[@]}"; do
    n=$((n + 1))
    address=$(field "$g" address)
    prefix="$g ($n/$count) · "
    log=$run/copy-$g.log
    sizes=$run/sizes-$g.tsv
    # Sizes of the closure, to turn the paths copied so far into data moved; progress still works without them
    nix path-info --json --recursive "$(readlink -e "$run/$g")" 2> /dev/null |
      jq -r 'if type == "array" then map([.path, (.narSize // 0)]) else to_entries | map([.key, (.value.narSize // 0)]) end | .[] | @tsv' > "$sizes" || : > "$sizes"
    started=$(date +%s)
    : > "$log"
    nix copy --no-check-sigs --to "ssh-ng://root@$address" "$(readlink -e "$run/$g")" > "$log" 2>&1 &
    copy_pid=$!
    while kill -0 "$copy_pid" 2> /dev/null; do
      copy_progress "$log" "$sizes" "$started" "$prefix" > "$ui_status"
      sleep 0.4
    done
    wait "$copy_pid" || {
      tail -n 12 "$log"
      return 1
    }
    [[ $action == update ]] || continue
    mapfile -t refs < <(jq -r --arg g "$g" '.guests[] | select(.name == $g) | .images[].image' "$run/plan.json")
    for image in "${refs[@]}"; do
      [[ -n $image ]] || continue
      printf '%spulling %s\n' "$prefix" "${image%%@*}" > "$ui_status"
      remote "$address" docker image inspect "$image" > /dev/null 2>&1 ||
        remote "$address" docker pull -q "$image"
    done
  done
}

# Refuse a stale review before attempting any activation or automatic recovery
unchanged() {
  local g=$1 address=$2
  [[ $(remote "$address" readlink -f /run/current-system) == "$(< "$run/$g.previous")" ]] || {
    echo "$g changed since the review; nothing further was deployed."
    return 1
  }
  if [[ $action == rollback ]]; then
    [[ $(remote "$address" readlink -f /nix/var/nix/profiles/system) == "$(awk -F '\t' '$1 == "current" { print $3 }' "$run/$g.generations")" ]] || {
      echo "$g's system profile changed since the review."
      return 1
    }
    [[ $(remote "$address" readlink -e "/nix/var/nix/profiles/system-$(< "$run/$g.generation")-link") == "$(candidate "$g")" ]] || {
      echo "$g's selected generation is no longer available."
      return 1
    }
  fi
}

# Switches one guest, then waits for every check and no failed units
deploy_one() {
  local g=$1 address=$2 new=$3
  if [[ $action == rollback ]]; then
    remote "$address" nixos-rebuild switch --store-path "$new" --no-reexec || return 1
  else
    nixos-rebuild switch --store-path "$new" --target-host "root@$address" --no-reexec || return 1
  fi
  [[ $(remote "$address" readlink -f /run/current-system) == "$new" ]] || {
    echo "$g does not run the new build"
    return 1
  }
  healthy "$(field "$g" settle)" "$address"
}

rollback_one() {
  deploy_one "$@"
}

# --- Review ---

# A list of name, versions and flag, majors first, at most limit rows
show_changes() {
  local file=$1 limit=${2:-0} name ver flag n=0 total
  total=$(wc -l < "$file")
  while IFS=$'\t' read -r name ver flag; do
    if ((limit && n == limit)); then
      note "  … $((total - limit)) more · c at the question lists them all"
      break
    fi
    item "$name" "$ver${flag:+  ${ui_bold}$flag${ui_off}}"
    n=$((n + 1))
  done < <(awk -F '\t' '{ print ($3 == "major" ? 0 : 1) "\t" $0 }' "$file" | LC_ALL=C sort -t $'\t' -k1,1n -k2,2 | cut -f2-)
}

review_guest() {
  local g=$1 limit=$2 title
  title="$g · stage $(field "$g" stage)"
  [[ $(field "$g" autoRollback) == true ]] && title+=" · rolls back by itself"
  section "$title"
  if [[ $action == rollback ]]; then
    note "Rollback to generation $(< "$run/$g.generation")"
    note "$(candidate "$g")"
  fi
  if [[ $(field "$g" containers) == self-managed ]]; then
    note "Its containers are updated by the app's own installer, not cix"
  fi
  if [[ $(< "$run/$g.state") == same ]]; then
    note "Up to date"
    return
  fi
  if [[ -s $run/$g.images ]]; then
    note "images"
    show_changes "$run/$g.images"
  fi
  note "packages"
  if [[ -s $run/$g.changes ]]; then
    show_changes "$run/$g.changes" "$limit"
  else
    item "same versions" "configuration or dependency changes only"
  fi
}

all_changes() {
  local g
  for g in "${changed[@]}"; do review_guest "$g" 0; done
  echo
}

# "1 guest", "2 guests"
count_guests() {
  if (($1 == 1)); then echo "1 guest"; else echo "$1 guests"; fi
}

# --- Run ---

phase=plan
load_plan "$REPO"
mapfile -t targets < <(guests)
section "cix $action $target"

if [[ $action == rollback ]] && $list; then
  prepare_rollbacks
  exit 0
fi

phase=preflight
task "Health" "$run/health.log" preflight
if [[ -s $run/baseline || -s $run/failed-units ]]; then
  mark_fail "Health" "$(wc -l < "$run/baseline") checks already fail, before anything is changed"
  while IFS= read -r name; do item "$name" "fails now"; done < "$run/baseline"
  while IFS= read -r name; do item "$name" "has failed units"; done < "$run/failed-units"
  if [[ $action == rollback ]]; then
    note "These checks must recover after rollback; they will not be ignored."
  else
    note "A service this update adds fails until its guest is deployed. A real outage is not fixed by an update."
  fi
  ask "Continue anyway?" || exit 1
  if [[ $action == rollback ]]; then
    : > "$run/baseline"
    mark_ok "Health" "baseline recorded; every check is required after rollback"
  else
    mark_ok "Health" "no failed units; those checks are not held against this update"
  fi
else
  mark_ok "Health" "$(count_guests "${#targets[@]}"), every check passes"
fi

: > "$run/images.tsv"
if [[ $action == rollback ]]; then
  phase=generations
  task "Generations" "$run/generations.log" prepare_rollbacks
  mark_ok "Generations" "$(count_guests "${#targets[@]}"), retained on their guests"
else
  if $update; then
    phase=inputs
    declare -A before
    for i in "${inputs[@]}"; do before[$i]=$(lock_rev "$i"); done
    task "Inputs" "$run/inputs.log" nix flake update "${inputs[@]}"
    moved=()
    for i in "${inputs[@]}"; do
      now=$(lock_rev "$i")
      [[ $now == "${before[$i]}" ]] || moved+=("$i ${before[$i]} → $now")
    done
    if ((${#moved[@]})); then
      mark_ok "Inputs" "${moved[0]}"
      for m in "${moved[@]:1}"; do detail "$m"; done
    else
      mark_ok "Inputs" "unchanged"
    fi
    [[ $target == pve ]] || detail "The inputs are shared: the other guests take them at their next deploy."

    if $images; then
      phase=images
      task "Images" "$run/images.log" bump_all
      newer=$(wc -l < "$run/images.tsv")
      if ((newer)); then
        mark_ok "Images" "$newer newer"
      else
        mark_ok "Images" "all current"
      fi
    else
      mark_ok "Images" "kept (--no-images)"
    fi
  else
    mark_ok "Inputs" "kept (--no-update)"
  fi

  # Checks, builds and the deploy all use this one snapshot of the tree
  phase=checks
  check_all() {
    snapshot
    nix flake check "$(jq -er '.path' "$run/source.json")" --no-update-lock-file
  }
  task "Checks" "$run/checks.log" check_all
  source=$(jq -er '.path' "$run/source.json")
  [[ $source == /nix/store/* && -f $source/flake.nix ]]
  load_plan "$source"
  mark_ok "Checks" "passed"

  phase=build
  task "Build" "$run/build.log" build_all
  mark_ok "Build" "$(count_guests "${#targets[@]}")"
fi

phase=review
task "Compare" "$run/compare.log" compare_all
changed=()
for g in "${targets[@]}"; do
  [[ $(< "$run/$g.state") == changed ]] && changed+=("$g")
done
for g in "${targets[@]}"; do review_guest "$g" 8; done
if [[ -s $run/host.tsv ]]; then
  section "Proxmox host (you update it yourself)"
  while IFS=$'\t' read -r k v; do item "$k" "$v"; done < "$run/host.tsv"
fi

if ((${#changed[@]} == 0)); then
  section "Everything is up to date"
  exit 0
fi
majors=$(for g in "${changed[@]}"; do
  awk -F '\t' -v g="$g" '$3 == "major" { print g "\t" $1 "\t" $2 }' "$run/$g.images" "$run/$g.changes"
done)
if [[ -n $majors ]]; then
  section "Major version jumps: read their release notes first"
  while IFS=$'\t' read -r g name ver; do printf '    %-10s %-22s %s\n' "$g" "$name" "$ver"; done <<< "$majors"
fi
if $dry; then
  echo
  note "Dry run: nothing deployed. Log  ${run/#$HOME/\~}"
  exit 0
fi

if [[ $action == update ]]; then
  section "Deploy"
  question="Deploy to"
else
  section "Rollback"
  question="Roll back"
fi
note "Order: $(printf '%s → ' "${changed[@]}" | sed 's/ → $//'). Each passes its checks before the next starts."
ask "$question $(count_guests "${#changed[@]}")?" "c all changes" all_changes || {
  note "Nothing was deployed."
  exit 0
}

# Everything lands on the guests while their DNS still works
if [[ $action == update ]]; then
  phase=download
  ui_status=$run/download.status
  task "Download" "$run/download.log" download_all
  ui_status=
  mark_ok "Download" "$(count_guests "${#changed[@]}") ready"
fi

phase=deploy
for g in "${changed[@]}"; do
  guest=$g
  address=$(field "$g" address)
  task "Review $g" "$run/review-$g.log" unchanged "$g" "$address"
  previous=$(< "$run/$g.previous")
  new=$(candidate "$g")
  if task "$g" "$run/deploy-$g.log" deploy_one "$g" "$address" "$new"; then
    [[ $action == rollback ]] || rm -- "$run/$g"
    previous=
    if [[ $action == update ]]; then
      mark_ok "$g" "deployed · checks pass"
    else
      mark_ok "$g" "rolled back · checks pass"
    fi
    continue
  fi
  if [[ $(field "$g" autoRollback) == true ]]; then
    back=$previous
    previous=
    if task "$g" "$run/rollback-$g.log" rollback_one "$g" "$address" "$back"; then
      mark_ok "$g" "back on its previous build and healthy"
    else
      previous=$back
      mark_fail "$g" "automatic recovery failed; inspect its log before continuing"
    fi
  fi
  exit 1
done

phase=complete
section "Done"
if [[ $action == update ]]; then
  mark_ok "Guests" "${#changed[@]} updated, every check passes"
else
  mark_ok "Guests" "${#changed[@]} rolled back, every check passes"
fi
[[ $action == update ]] || exit 0

# What the update changed in the repo: the lock file, and the files holding the moved image pins
recorded=()
while IFS= read -r file; do
  [[ -z $(git status --short -- "$file") ]] || recorded+=("$file")
done < <({
  echo flake.lock
  git diff --name-only | while IFS= read -r f; do git diff -U0 -- "$f" | grep -q '^[-+].*@sha256:' && echo "$f"; done
} | sort -u)
if ((${#recorded[@]} == 0)); then
  note "Nothing to commit in ${REPO/#$HOME/\~}"
  exit 0
fi
section "Record this update"
for file in "${recorded[@]}"; do
  if [[ $file == flake.lock ]]; then item "$file" "package versions"; else item "$file" "image pins"; fi
done
if ask "Commit them, so the repo matches what the servers run?"; then
  git add -- "${recorded[@]}"
  git commit -q -m "chore(flake): update the guests on pve" -- "${recorded[@]}"
  mark_ok "Committed" "chore(flake): update the guests on pve · not pushed"
else
  note "Left uncommitted in ${REPO/#$HOME/\~}"
fi
