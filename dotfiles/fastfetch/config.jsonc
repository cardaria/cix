{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "blue", "2": "cyan" },
    "padding": { "top": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "type": "string", "width": 8 },
    "size": { "binaryPrefix": "iec", "ndigits": 0 },
    "percent": { "type": 9 }
  },
  "modules": [
    { "type": "os", "key": "os", "format": "{name} {codename}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "shell", "key": "shell", "format": "{pretty-name}" },
    { "type": "terminal", "key": "term", "format": "{pretty-name}" },
    "break",
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "board", "key": "mobo", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "ram" },
    "break",
    { "type": "disk", "key": "disk", "folders": "/" }
  ]
}
